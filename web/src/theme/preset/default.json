{
  "name": "default",
  "desc": "Warm neutral GM workbench with graphite navigation and amber actions",
  "i18nkey": "theme.appearance.preset.default",
  "version": "1.0.0",
  "themeScheme": "light",
  "grayscale": false,
  "colourWeakness": false,
  "recommendColor": false,
  "themeColor": "#92651f",
  "otherColor": {
    "info": "#47778a",
    "success": "#288363",
    "warning": "#a07124",
    "error": "#bc5151"
  },
  "themeRadius": 8,
  "isInfoFollowPrimary": true,
  "layout": {
    "mode": "vertical",
    "scrollMode": "content"
  },
  "page": {
    "animate": false,
    "animateMode": "fade"
  },
  "header": {
    "height": 52,
    "breadcrumb": {
      "visible": true,
      "showIcon": true
    },
    "multilingual": {
      "visible": false
    },
    "globalSearch": {
      "visible": true
    }
  },
  "tab": {
    "visible": true,
    "cache": true,
    "height": 36,
    "mode": "button",
    "closeTabByMiddleClick": false
  },
  "fixedHeaderAndTab": true,
  "sider": {
    "inverted": true,
    "width": 220,
    "collapsedWidth": 64,
    "mixWidth": 90,
    "mixCollapsedWidth": 64,
    "mixChildMenuWidth": 200
  },
  "footer": {
    "visible": false,
    "fixed": false,
    "height": 36,
    "right": true
  },
  "watermark": {
    "visible": false,
    "text": "DNF GM",
    "enableUserName": false,
    "enableTime": false,
    "timeFormat": "YYYY-MM-DD HH:mm"
  },
  "tokens": {
    "light": {
      "colors": {
        "container": "rgb(255, 254, 251)",
        "layout": "rgb(245, 244, 240)",
        "inverted": "rgb(35, 39, 36)",
        "base-text": "rgb(41, 44, 40)"
      },
      "boxShadow": {
        "header": "0 1px 0 rgb(40, 42, 35, 0.08)",
        "sider": "1px 0 0 rgb(40, 42, 35, 0.08)",
        "tab": "0 1px 0 rgb(40, 42, 35, 0.08)"
      }
    },
    "dark": {
      "colors": {
        "container": "rgb(38, 42, 38)",
        "layout": "rgb(29, 33, 29)",
        "base-text": "rgb(231, 231, 220)"
      }
    }
  }
}
