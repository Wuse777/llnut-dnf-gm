[Unit]
Description=DNF GM opt-in fixed old-release cleanup
After=dnf-gm-monitor.service
[Service]
Type=oneshot
User=root
Slice=dnf-gm.slice
Environment=PYTHONPATH=/opt/dnf-gm/current/src
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/dnf-gm/venv/bin/python /opt/dnf-gm/current/deploy/cleanup_worker.py
TimeoutStartSec=180
Nice=19
IOSchedulingClass=idle
UMask=0022
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE
ReadWritePaths=/opt/dnf-gm/releases /var/lib/dnf-gm/cleanup /var/lib/dnf-gm/maintenance.lock /run/dnf-gm
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
InaccessiblePaths=-/var/lib/dnf -/root -/run/docker.sock -/var/run/docker.sock -/run/systemd/private -/run/dbus/system_bus_socket
